# Копіюй у .env.local (він у .gitignore, не комітиться).
# Локально й на Vercel — окремі значення. AUTH_SECRET на Vercel НЕ той
# самий, що локальний: генеруй окремо для кожного оточення.

# openssl rand -base64 33   (або: npx auth secret)
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (тип "Web application"), проєкт analytics-454817. Redirect URI:
#   локально:  http://localhost:3000/api/auth/callback/google
#   на Vercel: https://<домен>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Корпоративний вхід через M365 (Microsoft Entra ID), ANA-17 ─────────────
#
# App Registration в Entra ID: single tenant, платформа Web, redirect URI
#   локально:  http://localhost:3000/api/auth/callback/microsoft-entra-id
#   на Vercel: https://<домен>/api/auth/callback/microsoft-entra-id
# Дозволів понад User.Read не треба. У Token configuration обовʼязково
# додати optional claim `email` для ID-токена — без нього пошта в токен не
# приїжджає (запасний варіант у auth.config.ts — preferred_username).
#
# Немає всіх трьох змінних — немає ні провайдера, ні кнопки на вході.
# Google при цьому працює як працював: це навмисно, щоб міграція йшла
# двома кнопками, а не одним стрибком (інакше закриються всі одразу).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# ⚠️ ISSUER — з tenant ID, а не `/common/`: `/common/` пускає до екрана
# входу будь-який обліковий запис Microsoft у світі, включно з особистими.
# ⚠️ Закінчується на `/v2.0` БЕЗ слеша: Auth.js звіряє цей рядок із полем
# `issuer` well-known-документа символ у символ, а Microsoft віддає його
# без слеша — зі слешем вхід падає ще на discovery.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Supabase — список доступів (таблиця dashboard_users).
# Хто може заходити і з якою роллю тепер редагується на сторінці /admin,
# а не тут: раніше це були ALLOWED_EMAILS / ADMIN_EMAILS, і додати колегу
# означало полізти в налаштування Vercel і дочекатись редеплою.
#
# ⚠️ SERVICE_ROLE обходить RLS. Він потрібен саме тому, що таблиця
# закрита політиками наглухо й читається лише з сервера. У браузер не
# віддавати ніколи; на Vercel додавати як звичайну (не Public) змінну.
# Взяти: Supabase → Project Settings → API → service_role.
SUPABASE_URL=https://fqajklyccxkowoaaglky.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Живі курсори (приколюха, видно лише тим, хто в списку) ──────────────
#
# Кому видно чужі курсори й список присутніх. Через кому, у нижньому
# регістрі. Порожньо або відсутнє — фічі немає ні в кого, і це дефолт:
# компонент нічого не малює й не збирає.
#
# ⚠️ Перевірка робиться на СЕРВЕРІ (layout читає сесію), тому цей ключ —
# без NEXT_PUBLIC_: у браузер він не їде.
#
# ⚠️ Тут ПОШТА, а не людина: після переїзду на корпоративний вхід (ANA-17)
# та сама людина заходить під іншою адресою, і фіча мовчки зникає — жодної
# помилки не буде. Оновлювати разом з рядками в `/admin`.
LIVE_WATCHERS=

# Публічний ключ Supabase для Realtime-каналу курсорів. Це anon/publishable
# ключ, а НЕ service_role: він за задумом лежить у бандлі й видний усім,
# хто відкриє DevTools. service_role у браузер не потрапляє ніколи.
#
# Взяти: Supabase → Project Settings → API → anon public.
# Без цих двох змінних курсорів просто немає — помилок теж.
NEXT_PUBLIC_SUPABASE_URL=https://fqajklyccxkowoaaglky.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Експериментальні функції (наратив по аномаліях) ───────────────────────
# Кому видно функції на обкатці. Через кому, у нижньому регістрі.
#
# ⚠️ Дефолт fail-closed: якщо змінна порожня, залогіненим не видно нікому.
# Це НЕ те саме, що LIVE_WATCHERS вище: там без сесії теж порожньо, а тут
# без сесії видно — інакше локальний перегляд (де логіну немає взагалі)
# показував би порожню сторінку замість функції. Деталі — lib/lab.ts.
LAB_EMAILS=

# Ключ OpenAI для генерації наративу (scripts/build-narrative.mjs).
# Потрібен ТІЛЬКИ на кроці складання — у рантайм дашборду не їде, у бандл
# не потрапляє. Без нього скрипт не падає: віддає детерміновані шаблони,
# зібрані з рядків детектора аномалій.
OPENAI_API_KEY=

# Модель наративу. Дефолт у коді — gpt-5.6-luna; змінна дозволяє
# перемкнутись без релізу. NARRATIVE_EFFORT — зусилля на міркування
# (дефолт low: задача вузька, довші міркування тут лише дорожчі).
NARRATIVE_MODEL=
NARRATIVE_EFFORT=
