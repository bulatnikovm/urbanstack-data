# Копіюй у .env.local (він у .gitignore, не комітиться).
# Локально й на Vercel — окремі значення. AUTH_SECRET на Vercel НЕ той
# самий, що локальний: генеруй окремо для кожного оточення.

# openssl rand -base64 33   (або: npx auth secret)
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (тип "Web application"). Redirect URI:
#   локально:  http://localhost:3000/api/auth/callback/google
#   на Vercel: https://<домен>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Хто взагалі може увійти — інакше валідний Google-акаунт нічого не важить,
# сесія все одно відхиляється в auth.config.ts (signIn callback).
ALLOWED_EMAILS=nikitabulatnikov07@gmail.com

# Підмножина ALLOWED_EMAILS з роллю admin (поки лише admin/viewer,
# гранулярні ролі — Фаза E, план §10).
ADMIN_EMAILS=nikitabulatnikov07@gmail.com
