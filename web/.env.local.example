# Копіюй у .env.local (він у .gitignore, не комітиться).
# Локально й на Vercel — окремі значення. AUTH_SECRET на Vercel НЕ той
# самий, що локальний: генеруй окремо для кожного оточення.

# openssl rand -base64 33   (або: npx auth secret)
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (тип "Web application"), проєкт analytics-454817. Redirect URI:
#   локально:  http://localhost:3000/api/auth/callback/google
#   на Vercel: https://<домен>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase — список доступів (таблиця dashboard_users).
# Хто може заходити і з якою роллю тепер редагується на сторінці /admin,
# а не тут: раніше це були ALLOWED_EMAILS / ADMIN_EMAILS, і додати колегу
# означало полізти в налаштування Vercel і дочекатись редеплою.
#
# ⚠️ SERVICE_ROLE обходить RLS. Він потрібен саме тому, що таблиця
# закрита політиками наглухо й читається лише з сервера. У браузер не
# віддавати ніколи; на Vercel додавати як звичайну (не Public) змінну.
# Взяти: Supabase → Project Settings → API → service_role.
SUPABASE_URL=https://fqajklyccxkowoaaglky.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Живі курсори (приколюха, видно лише тим, хто в списку) ──────────────
#
# Кому видно чужі курсори й список присутніх. Через кому, у нижньому
# регістрі. Порожньо або відсутнє — фічі немає ні в кого, і це дефолт:
# компонент нічого не малює й не збирає.
#
# ⚠️ Перевірка робиться на СЕРВЕРІ (layout читає сесію), тому цей ключ —
# без NEXT_PUBLIC_: у браузер він не їде.
LIVE_WATCHERS=

# Публічний ключ Supabase для Realtime-каналу курсорів. Це anon/publishable
# ключ, а НЕ service_role: він за задумом лежить у бандлі й видний усім,
# хто відкриє DevTools. service_role у браузер не потрапляє ніколи.
#
# Взяти: Supabase → Project Settings → API → anon public.
# Без цих двох змінних курсорів просто немає — помилок теж.
NEXT_PUBLIC_SUPABASE_URL=https://fqajklyccxkowoaaglky.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
